# 이 파일을 복사해 .env.local 로 쓰거나, Vercel 프로젝트 설정 > Environment Variables 에 넣는다.
# 실제 값은 절대 저장소에 커밋하지 않는다.

# Supabase 프로젝트 URL (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase secret 키 (Project Settings > API Keys > Secret keys). 서버에서만 쓰인다.
SUPABASE_SECRET_KEY=
# /stats?key=… 로 측정 결과를 볼 때 쓰는 비밀 문자열. 아무도 못 맞힐 긴 값으로.
STATS_KEY=
