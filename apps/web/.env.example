# 이 파일을 복사해 .env.local 로 쓰거나, Vercel 프로젝트 설정 > Environment Variables 에 넣는다.
# 실제 값은 절대 저장소에 커밋하지 않는다.

# Supabase 프로젝트 URL (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Supabase secret 키 (Project Settings > API Keys > Secret keys). 서버에서만 쓰인다.
SUPABASE_SECRET_KEY=
# /stats?key=… 로 측정 결과를 볼 때 쓰는 비밀 문자열. 아무도 못 맞힐 긴 값으로.
STATS_KEY=

# 지인 테스트: 결제 버튼을 누른 사람에게 두 번째 장을 무료로 열어 준다. on 일 때만 켜진다.
SECOND_PAGE_FREE=
# Anthropic API 키 (console.anthropic.com). 두 번째 장 AI 생성에 쓴다. 사용량 한도를 꼭 걸어 둔다.
ANTHROPIC_API_KEY=
# 선택: 모델 바꾸기 (비워 두면 claude-opus-5-5)
ANTHROPIC_MODEL=
